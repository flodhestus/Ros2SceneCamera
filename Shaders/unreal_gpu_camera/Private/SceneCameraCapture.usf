#include "/Engine/Private/Common.ush"

Texture2D<float4> InputTexture;
RWStructuredBuffer<uint> OutRgb8Packed;
uint2 InputSize;

[numthreads(THREADGROUP_SIZE_X, THREADGROUP_SIZE_Y, 1)]
void SceneCameraCaptureCS(uint3 DTid : SV_DispatchThreadID)
{
	const uint2 P = DTid.xy;
	if (P.x >= InputSize.x || P.y >= InputSize.y)
	{
		return;
	}

	const float4 C = InputTexture.Load(int3(P, 0));
	const float3 Linear = saturate(C.rgb);
	const uint R = (uint)(Linear.r * 255.0);
	const uint G = (uint)(Linear.g * 255.0);
	const uint B = (uint)(Linear.b * 255.0);
	const uint PixelIndex = P.y * InputSize.x + P.x;
	OutRgb8Packed[PixelIndex] = R | (G << 8u) | (B << 16u) | (255u << 24u);
}
