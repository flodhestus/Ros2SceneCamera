#include "/Engine/Private/Common.ush"

Texture2D<float4> InputTexture;
RWByteAddressBuffer OutRgb8;
uint2 InputSize;

[numthreads(THREADGROUP_SIZE, THREADGROUP_SIZE, 1)]
void SceneCameraCaptureCS(uint3 DTid : SV_DispatchThreadID)
{
	uint2 P = DTid.xy;
	if (P.x >= InputSize.x || P.y >= InputSize.y)
	{
		return;
	}
	const float4 C = InputTexture.Load(int3(P, 0));
	const float3 Linear = saturate(C.rgb);
	const uint R = (uint)(Linear.r * 255.0);
	const uint G = (uint)(Linear.g * 255.0);
	const uint B = (uint)(Linear.b * 255.0);
	const uint ByteBase = (P.y * InputSize.x + P.x) * 3u;
	OutRgb8.Store(ByteBase, R);
	OutRgb8.Store(ByteBase + 1u, G);
	OutRgb8.Store(ByteBase + 2u, B);
}
